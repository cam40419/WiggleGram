# Copy to .env in the repository root. Restart the app after editing.
# The UC-512 HAT is one libcamera device carrying a 2x2 composite.
# Keep the full native composite. Each rotated view is cropped to 16:9 after
# alignment, retaining original pixels without downscaling or upscaling.
WIGGLEGRAM_CAMERA_INDEX=0
WIGGLEGRAM_CAPTURE_WIDTH=4656
WIGGLEGRAM_CAPTURE_HEIGHT=3496
WIGGLEGRAM_VF_WIDTH=1164
WIGGLEGRAM_VF_HEIGHT=874
WIGGLEGRAM_VF_FPS=15

# Auto: continuous preview focus, then one startup focus sweep for stills.
# Allow AWB and focus to settle before the capture signal.
WIGGLEGRAM_FOCUS_MODE=auto
WIGGLEGRAM_SETTLE_MS=2000

# For repeatable fixed focus, use manual mode and a lens position in dioptres.
# WIGGLEGRAM_FOCUS_MODE=manual
# WIGGLEGRAM_LENS_POSITION=1.0

# Existing exposure and flash timing; verify timing on the new hardware.
WIGGLEGRAM_SHUTTER_US=100002
WIGGLEGRAM_FLASH_OFFSET_S=0.30
WIGGLEGRAM_CAPTURE_TIMEOUT_S=15

# Normally libcamera selects the correct IMX519 tuning automatically.
# WIGGLEGRAM_TUNING_FILE=/path/to/imx519.json

# Defaults: camera/ under the repository; calibrate/out/imx519/ under src/.
# WIGGLEGRAM_MEDIA_DIR=/home/admin/wigglegram/camera
# WIGGLEGRAM_CALIBRATION_DIR=/home/admin/wigglegram/src/calibrate/out/imx519
